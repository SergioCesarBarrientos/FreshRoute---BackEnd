extends ../layout

block content
    a.volver(href="/usuarios/lista") ← Volver a la lista

    h1 Editar Usuario

    form(action="/usuarios/editar/" + usuario._id method="POST")
        div
            label(for="nombre") Nombre completo:
            input(type="text" name="nombre" id="nombre" value=usuario.nombre required)

        div
            label(for="email") Correo electrónico:
            input(type="email" name="email" id="email" value=usuario.email required)

        div
            label(for="password") Nueva Contraseña (opcional):
            input(
                type="password" 
                name="password" 
                id="password" 
                placeholder="Dejar en blanco para no cambiarla")

        div
            label(for="rol") Rol:
            select(name="rol" id="rol" required)
                option(value="administrativo" selected=(usuario.rol === 'administrativo')) Administrativo
                option(value="repartidor" selected=(usuario.rol === 'repartidor')) Repartidor
                option(value="admin" selected=(usuario.rol === 'admin')) Administrador

        div.acciones-form
            button(type="submit") Guardar cambios
            a(href="/usuarios" class="btn-cancelar") Cancelar