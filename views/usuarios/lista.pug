extends ../layout

block content
    h1 Lista de Usuarios

    .nav
        a(href="/") Volver al inicio
        a(href="/usuarios/nuevo") Agregar usuario

    if usuarios && usuarios.length > 0
        ul
            each usuario in usuarios
                li
                    div.info
                        strong= usuario.nombre
                        span 📧 #{usuario.email}
                        span 🛡️ Rol: #{usuario.rol}

                    div.acciones
                        form(action="/usuarios/editar/" + usuario._id method="GET" class="form-inline")
                            button(type="submit" class="btn-editar") Editar

                        form(action="/usuarios/eliminar/" + usuario._id method="POST" class="form-inline")
                            button(type="submit" class="btn-eliminar" onclick="return confirm('¿Eliminar este usuario?')") Eliminar
    else
        p No hay usuarios registrados.