extends ../layout

block content
    div.login-container
        h1 Panel de Usuario
        
        if error
            p.error-message= error

        form(action="/login" method="POST" class="login-form")
            div
                label(for="email") Usuario o Correo:
                input(
                    type="text" 
                    name="email" 
                    id="email" 
                    placeholder="Usuario o email"
                    required
                )
            div
                label(for="password") Contraseña:
                input(
                    type="password"
                    name="password"
                    id="password"
                    placeholder="••••••••"
                    required
                )
            div
                button(type="submit") Ingresar