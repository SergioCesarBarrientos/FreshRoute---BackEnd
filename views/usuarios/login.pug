extends ../layout

block content
    div.login-container
        h1 Iniciar Sesión
        
        if error
            p.error-message= error

        form(action="/login" method="POST" class="login-form")
            div
                label(for="email") Correo electrónico:
                input(
                    type="email"
                    name="email"
                    id="email"
                    placeholder="tu@email.com"
                    required
                )
            div
                label(for="password") Contraseña:
                input(
                    type="password"
                    name="password"
                    id="password"
                    placeholder="••••••••"
                    required
                )
            div
                button(type="submit") Ingresar