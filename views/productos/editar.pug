extends ../layout

block content
    a.volver(href="/productos") ← Volver a la lista

    h1 Editar Producto

    form(action="/productos/editar/" + producto._id method="POST")
        div
            label(for="nombre") Nombre:
            input(type="text" name="nombre" id="nombre" value=producto.nombre required)

        div
            label(for="precio") Precio:
            input(type="number" name="precio" id="precio" value=producto.precio min="0" required)

        div
            label(for="stock") Stock:
            input(type="number" name="stock" id="stock" value=producto.stock min="0" required)

        div.acciones-form
            button(type="submit") Guardar cambios
            a(href="/productos" class="btn-cancelar") Cancelar