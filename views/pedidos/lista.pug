
extends ../layout

block content
    h1
        i.fas.fa-clipboard-list
        |  Lista de Pedidos

    nav.nav
        a(href="/")
            i.fas.fa-arrow-left
            |  Volver al inicio

        //- Solo SuperAdmin y Administrativo pueden crear pedidos
        if usuarioLogueado && (usuarioLogueado.rol === 'superadmin' || usuarioLogueado.rol === 'administrativo')
            a(href="/pedidos/nuevo" class="btn-agregar")
                i.fas.fa-plus
                |  Nuevo pedido

    //- Filtro por estado
    form(action="/pedidos" method="GET" class="buscador filtro-pedidos")
        div.filtro-pedidos-select
            i.fas.fa-filter
            select(name="estado")
                option(value="" selected=(!estado)) Todos los estados
                each e in ['Asignado', 'En camino', 'Entregado', 'Cancelado']
                    option(value=e selected=(estado === e))= e

        button(type="submit")
            i.fas.fa-search
            |  Filtrar

        if estado
            a(href="/pedidos" class="btn-limpiar")
                i.fas.fa-times
                |  Limpiar

    if pedidos && pedidos.length > 0
        .tabla-contenedor
            table.tabla-pedidos
                thead
                    tr
                        th
                            i.fas.fa-calendar
                            |  Fecha
                        th
                            i.fas.fa-user
                            |  Cliente
                        th
                            i.fas.fa-dollar-sign
                            |  Total
                        th
                            i.fas.fa-circle-dot
                            |  Estado
                        th
                            i.fas.fa-truck
                            |  Repartidor
                        th Acciones

                tbody
                    each pedido in pedidos
                        tr
                            td.fecha-pedido
                                i.fas.fa-calendar-day
                                |  #{pedido.createdAt ? pedido.createdAt.toLocaleDateString('es-AR') : '—'}

                            td
                                strong.nombre-cliente
                                    i.fas.fa-user-circle
                                    |  #{pedido.cliente ? pedido.cliente.nombre : '(cliente eliminado)'}

                            td.total-pedido
                                |  $#{pedido.total.toLocaleString('es-AR')}

                            td
                                span(class="estado-pedido estado-" + pedido.estado.toLowerCase().replace(' ', '-'))
                                    i.fas.fa-circle
                                    |  #{pedido.estado}

                            td.repartidor-pedido
                                if pedido.repartidor
                                    i.fas.fa-user
                                    |  #{pedido.repartidor.nombre} #{pedido.repartidor.apellido}
                                else
                                    span.sin-repartidor
                                        i.fas.fa-minus
                                        |  Sin asignar

                            td
                                div.acciones.acciones-pedidos
                                    //- Ver detalle
                                    form(action="/pedidos/detalle/" + pedido._id method="GET" class="form-inline")
                                        button(type="submit" class="btn-editar")
                                            i.fas.fa-eye
                                            |  Detalle

                                    //- Solo cancelar pedidos asignados
                                    if pedido.estado === 'Asignado'
                                        form(action="/pedidos/" + pedido._id + "/cancelar" method="POST" class="form-inline")
                                            button(type="submit" class="btn-eliminar" onclick="return confirm('¿Cancelar este pedido?')")
                                                i.fas.fa-ban
                                                |  Cancelar
    else
        div.mensaje-vacio
            i.fas.fa-clipboard-list
            h2 No se encontraron pedidos
            p No hay pedidos registrados para el estado seleccionado.
