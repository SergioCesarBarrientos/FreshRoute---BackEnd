extends ../layout

block content
    a.volver(href="/perfil") ← Volver a mi perfil

    h1 Cambiar Contraseña

    .perfil-container
        .perfil-password
            form(action="/perfil/cambiar-password" method="POST")
                div
                    label(for="passwordActual") Contraseña actual:
                    input(type="password" name="passwordActual" id="passwordActual" required)
                
                div
                    label(for="passwordNueva") Nueva contraseña:
                    input(type="password" name="passwordNueva" id="passwordNueva" required)
                
                div.acciones-form
                    button(type="submit") Cambiar Contraseña